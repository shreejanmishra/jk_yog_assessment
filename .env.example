# Neon PostgreSQL connection strings (provisioned via Vercel Marketplace or Neon console)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application secrets
SESSION_SECRET=replace-with-32-byte-random-hex-secret
CRON_SECRET=replace-with-cron-secret

# Optional ISO date/timestamp override (YYYY-MM-DD or ISO-8601) for testing festival dates
BOOKING_CLOCK_OVERRIDE=
