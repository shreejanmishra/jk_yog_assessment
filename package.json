{
  "name": "sharad-utsav-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sharad Utsav 2026 festival ticket booking portal (React + Vite + Express 5 + Neon Postgres)",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch src/server/dev.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch src/server/dev.ts",
    "build:api": "node scripts/bundle-api.mjs",
    "build": "npm run typecheck && npm run build:api && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:reset-stock": "tsx scripts/reset-stock.ts",
    "race": "tsx scripts/race-workshop.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fontsource/playfair-display": "^5.1.1",
    "@vercel/functions": "^2.0.0",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.475.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.29.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tailwindcss/vite": "^4.0.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.0",
    "fast-check": "^3.23.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
